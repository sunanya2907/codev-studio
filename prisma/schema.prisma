generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Tier {
  FREE
  STANDARD
  PRO
  EXCLUSIVE
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  tier         Tier     @default(FREE)
  tokenBalance Int      @default(3)
}