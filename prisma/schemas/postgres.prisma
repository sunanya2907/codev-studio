generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Tier {
  FREE
  STANDARD
  PRO
  EXCLUSIVE
}

model User {
  id              String             @id @default(uuid())
  name            String?
  email           String             @unique
  password        String?            // Added for Credentials / Email-Password Auth
  emailVerified   DateTime?
  image           String?
  stripeCustomerId String?           @unique
  stripeSubscriptionId String?
  planExpiresAt   DateTime?          // Razorpay plans are prepaid for 30 days; null for Stripe subscriptions
  tier            Tier               @default(FREE)
  tokenBalance    Int                @default(3)
  voiceSeconds    Int                @default(0) // prepaid voice time; 1 token buys VOICE_SECONDS_PER_TOKEN
  tokenPeriodStart DateTime          @default(now()) // start of the current monthly token period (see lib/tokens.ts)
  termsAccepted   Boolean            @default(false)
  termsAcceptedAt DateTime?          // set only when the user accepts the terms
  // Admin dashboard (see lib/activity.ts): last seen info + block switch
  blockedAt       DateTime?          // set by an admin: the person can no longer use the app
  blockedReason   String?
  lastLoginAt     DateTime?
  lastLogoutAt    DateTime?
  lastIp          String?
  lastCountry     String?
  lastCity        String?
  loginCount      Int                @default(0)
  projects        Project[]
  history         GenerationHistory[]
  voiceSessions   VoiceSession[]
  testerRedemptions TesterRedemption[]
  accounts        Account[]
  sessions        Session[]
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt
}

model Account {
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?  @db.Text
  access_token      String?  @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?  @db.Text
  session_state     String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([provider, providerAccountId])
}

model Session {
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@id([identifier, token])
}

// A 6-digit code emailed to the user before they may enter the account (see lib/email-verify.ts).
// Only a hash of the code is stored.
model EmailVerification {
  userId    String   @id
  codeHash  String
  expiresAt DateTime
  attempts  Int      @default(0)
  sentAt    DateTime @default(now())
}

model Project {
  id           String   @id @default(uuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name         String   @default("Untitled App")
  spec         String?  @db.Text
  frontendCode String?  @db.Text
  backendCode  String?  @db.Text
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([userId])
}

model GenerationHistory {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  prompt    String   @db.Text
  spec      String   @db.Text
  frontend  String   @db.Text
  backend   String   @db.Text
  database  String   @db.Text
  qa        String   @db.Text
  flow      String?  @db.Text // Agent 6: pseudocode + flowcharts (Markdown with mermaid blocks)
  status    String   @default("DONE") // BUILDING | DONE | FAILED
  error     String?  @db.Text
  cost      Int      @default(1) // tokens charged for this build (1 normal, 3 advanced); refunded if it fails
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, createdAt])
  @@index([status, createdAt])
}

// Stripe retries webhooks, so every event id is stored once to make sure
// tokens/plans are never granted twice for the same payment.
model StripeEvent {
  id        String   @id
  type      String
  createdAt DateTime @default(now())
}

// Every Razorpay payment id is stored once, so verify + webhook can both run safely
// without ever granting a plan or tokens twice.
model RazorpayPayment {
  id        String   @id // razorpay payment id (pay_...)
  orderId   String
  userId    String
  kind      String   // "plan" | "tokens"
  createdAt DateTime @default(now())

  @@index([userId])
}


// One voice conversation. Time is billed by the server clock (see lib/voice.ts).
model VoiceSession {
  id            String    @id @default(cuid())
  userId        String
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  status        String    @default("active") // active | ended
  startedAt     DateTime  @default(now())
  lastTickAt    DateTime  @default(now())
  endedAt       DateTime?
  secondsBilled Int       @default(0)

  @@index([userId, status])
}


// Errors caught by the background debug agent (see lib/debug-agent.ts).
// Identical errors share one row (same fingerprint) and just increase `count`.
model ErrorLog {
  id          String    @id @default(cuid())
  fingerprint String    @unique
  source      String    // server | client
  message     String    @db.Text
  stack       String?   @db.Text
  route       String?
  method      String?
  userId      String?   // plain column on purpose: logs must outlive deleted users
  count       Int       @default(1)
  status      String    @default("NEW") // NEW | ANALYZING | DIAGNOSED | FAILED | RESOLVED
  attempts    Int       @default(0)
  severity    String?   // low | medium | high | critical
  diagnosis   String?   @db.Text // Markdown written by the agent: cause + suggested fix
  firstSeenAt DateTime  @default(now())
  lastSeenAt  DateTime  @default(now())
  analyzedAt  DateTime?
  updatedAt   DateTime  @updatedAt

  @@index([status, lastSeenAt])
}


// Tester / developer invite links (see lib/tester.ts). Only a SHA-256 hash of the secret
// token is stored, so a database leak does not leak working links.
model TesterInvite {
  id          String    @id @default(cuid())
  tokenHash   String    @unique
  label       String
  tier        Tier      @default(EXCLUSIVE)
  tokens      Int       @default(50)
  accessDays  Int       @default(14)  // how long a tester keeps the plan after redeeming
  maxUses     Int       @default(10)
  uses        Int       @default(0)
  expiresAt   DateTime                // the link itself stops working after this
  revokedAt   DateTime?
  createdBy   String
  createdAt   DateTime  @default(now())
  redemptions TesterRedemption[]

  @@index([createdAt])
}

model TesterRedemption {
  id         String       @id @default(cuid())
  inviteId   String
  invite     TesterInvite @relation(fields: [inviteId], references: [id], onDelete: Cascade)
  userId     String
  user       User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  redeemedAt DateTime     @default(now())

  @@unique([inviteId, userId])
  @@index([userId])
}

// ---------------------------------------------------------------------------------------------
// Admin dashboard: who logged in / out and from where, what people did, AI calls, requests, audit.
// userId columns are plain strings on purpose: these logs must outlive deleted users.
// ---------------------------------------------------------------------------------------------
model LoginEvent {
  id        String   @id @default(cuid())
  userId    String?
  email     String?
  type      String   // LOGIN | LOGOUT | LOGIN_FAILED
  method    String?  // google | credentials
  ip        String?
  country   String?
  region    String?
  city      String?
  device    String?  // e.g. "Chrome on Windows"
  userAgent String?  @db.Text
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
  @@index([type, createdAt])
  @@index([createdAt])
}

model UserActivity {
  id        String   @id @default(cuid())
  userId    String
  kind      String   // BUILD | CUSTOMIZE | QUESTIONS | ENHANCE | DOMAIN_SEARCH | VOICE | TESTER_REDEEM | REQUEST
  detail    String?  @db.Text // what the person typed / searched
  tokens    Int      @default(0)
  ip        String?
  country   String?
  city      String?
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
  @@index([kind, createdAt])
  @@index([createdAt])
}

// One row per AI provider call (success or failure): the numbers behind the API / usage page.
model AiCallLog {
  id        String   @id @default(cuid())
  userId    String?
  purpose   String?
  model     String
  ok        Boolean
  ms        Int      @default(0)
  error     String?  @db.Text
  tokensIn  Int      @default(0)
  tokensOut Int      @default(0)
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([model, createdAt])
}

// A person asks the admin for something (tester access, more tokens, an upgrade). The admin accepts or rejects.
model AccessRequest {
  id          String    @id @default(cuid())
  userId      String
  email       String
  type        String    // TESTER | TOKENS | UPGRADE | OTHER
  message     String    @db.Text
  status      String    @default("PENDING") // PENDING | ACCEPTED | REJECTED
  grantTier   String?
  grantTokens Int       @default(0)
  grantDays   Int       @default(0)
  adminNote   String?   @db.Text
  decidedBy   String?
  decidedAt   DateTime?
  createdAt   DateTime  @default(now())

  @@index([status, createdAt])
  @@index([userId])
}

// Everything an admin changes (tokens, plans, blocks, requests) is written here.
model AdminAction {
  id           String   @id @default(cuid())
  adminEmail   String
  action       String
  targetUserId String?
  detail       String?  @db.Text
  createdAt    DateTime @default(now())

  @@index([createdAt])
}
